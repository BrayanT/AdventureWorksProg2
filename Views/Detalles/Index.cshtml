</div>
<img src="@Model.PhotoB64" height="250" />

<h3>Descripci&oacute;n:</h3>
<div style="border: 1px solid #0070fc30" class="col-md-8 border-primary rounded p-2 mb-3">
    <h5 class="fw-normal">@Model.Description</h5>
</div>
<h6>Creado en: <span class="fw-normal">@Model.CreatedDate.ToString("dd/MM/yyyy hh:MM tt")</span></h6>


<div id="contenedor-partial" class="mt-3"></div>
@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">@ViewBag.Mensaje</div>
}
@if (ViewBag.MensajeError != null)
{
    <input type="hidden" id="flagError" />
    <div class="alert alert-danger">@ViewBag.MensajeError</div>    
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetch("@Url.Action("LoadComments", "Detalles")" + "?PhotoId=" + '@Model.PhotoId')
            .then(response => response.text())
            .then(html => {
                $("#contenedor-partial").html(html);
                if ($("#flagError").length > 0) {
                    AddNewCommentHtml();
                }
            });
    });
</script>