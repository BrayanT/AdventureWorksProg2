@{
    ViewBag.Title = "Index";
}
<div class="d-flex col-md-8">
    <div class="col-6">
        <h3>@Model.Title</h3>
        <h4>Por: <span class="text-primary">@Model.OwnerName</span></h4>
    </div>
    @if (Model.Owner == ViewBag.UserLogin.Username)
    {


