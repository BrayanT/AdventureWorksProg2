<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

    @{
        var user = Session["user"] as AdventureWorks_POC.Models.User;
    }

    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("AdventureWorks", "Index", "Galeria", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Galeria", "Index", "Galeria", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Agregar Foto", "SubirFoto", "Galeria", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
                @if (user != null)
                {
                    <span class="navbar-text text-white">
                        Hola, @user.Username&nbsp;&nbsp;|&nbsp;&nbsp;
                    </span>
                    <span class="navbar-text text-white">
                        @Html.ActionLink("Cerrar Sesion", "CerrarSesion", "Home", new { area = "" }, new { @class = "nav-link" })
                    </span>
                 }
                 else {
                    <span class="navbar-text text-white">
                        @Html.ActionLink("Iniciar Sesion", "Login", "Acceso", new { area = "" }, new { @class = "nav-link" })
                    </span>
                 }
                <span class="navbar-text text-white">
                </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
